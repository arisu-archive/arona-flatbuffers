include "DisplayGroupType.fbs";

namespace MX.Data.Excel;

table KeyMappingExcel {
    id: string;
    display_group_type: DisplayGroupType;
    group_id: string;
    enable_custom_mapping: bool;
    display_custom_mapping: bool;
    localize_key_mapping_id: uint;
    target_key_code: string;
    controller_cursor_focus: bool;
